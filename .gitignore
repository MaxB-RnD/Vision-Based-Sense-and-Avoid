# ==============================================================================
# C/C++ & CMake Build Artifacts
# ==============================================================================
#
# Ignore Any Build Directories Created by CMake or Manual Builds.
**/build/
**/bin/
**/out/

# Object & Library Files.
**/*.o
**/*.obj
**/*.a
**/*.lib
**/*.so
**/*.dylib
**/*.dll

# Executables.
**/*.exe
**/*.out
**/*.app

# CMake Internal Files.
**/CMakeCache.txt
**/CMakeFiles/
**/cmake_install.cmake
**/Makefile
# ==============================================================================


# ==============================================================================
# Python & Virtual Environments
# ==============================================================================
#
# Ignore Virtual Environments by Common Names.
**/venv/
**/.venv/
**/env/
**/ENV/

# Python Bytecode & Caches.
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.pytest_cache/
**/.mypy_cache/

# Distribution & Packaging.
**/dist/
**/build/
**/*.egg
# ==============================================================================


# ==============================================================================
# Integrated Development Environment (IDE) & OS
# ==============================================================================
#
# VS Code Settings.
**/.vscode/
**/.history/

# OS-Specific Clutter.
**/.DS_Store
**/Thumbs.db
# ==============================================================================


# ==============================================================================
# Research & Data
# ==============================================================================
#
# Ignore Large Dataset Files or Local Logs.
**/*.log
**/*.csv
**/*.npy
**/*.onnx

# Ignore Custom AOT Data.
**/data*
**/results*
# ==============================================================================
